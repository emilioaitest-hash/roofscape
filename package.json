{
  "name": "@app/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build && node scripts/postbuild.mjs",
    "typecheck": "tsc --build --force",
    "test": "npm run build && node scripts/test.mjs",
    "desktop": "npm run build && npm run start -w @app/desktop",
    "desktop:dist": "npm run build && npm run dist -w @app/desktop"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/google": "^4.0.51",
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "ai": "^7.0.79"
  }
}
