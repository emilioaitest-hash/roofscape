node_modules/
dist/
build/
# electron-builder's buildResources directory is source, not output, and the
# rule above swallowed it. The signing hook was ignored, never committed, and
# every release build failed on a module it could not find — while building
# here kept working, because here the file was on disk.
!apps/desktop/build/
!apps/desktop/build/**
.turbo/
*.tsbuildinfo

# local state & secrets — never commit
.env
.env.*
!.env.example
data/
*.db
*.db-shm
*.db-wal

# os
.DS_Store

# desktop app build output
apps/desktop/release/
apps/desktop/public/
.scratch/
.tsbuildinfo
